[gd_scene format=3 uid="uid://dyxpcrdltwrtr"]

[sub_resource type="GDScript" id="GDScript_g4v7s"]
script/source = "extends RigidBody3D

var isNextToLoot = false

func _on_area_3d_body_entered(body: Node3D) -> void:
	if body is CharacterBody3D:
		isNextToLoot = true

func _on_area_3d_body_exited(body: Node3D) -> void:
	if body is CharacterBody3D:
		isNextToLoot = false

func _unhandled_input(event: InputEvent) -> void:
	if isNextToLoot and event is InputEventKey and event.pressed and not event.echo and event.keycode == KEY_E and Global.lootHeld < 3:
		Global.lootHeld += 1
		queue_free()
"

